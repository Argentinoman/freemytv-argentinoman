<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV and the inputs: the TV's own screen starts black and the picture comes later, so it waits, hidden, until
     the home screen has faded to black, and only then shows (black, then the picture): no flash, no double fade. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="0" android:toAlpha="1" android:startOffset="110" android:duration="60" />
